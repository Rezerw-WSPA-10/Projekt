    <bpmn:sequenceFlow id="Flow_7" name="tak" sourceRef="G0" targetRef="T5" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="T5" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_9" name="nie" sourceRef="G1" targetRef="E_ok" />
