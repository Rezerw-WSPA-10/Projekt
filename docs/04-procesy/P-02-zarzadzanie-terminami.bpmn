<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_P02_Terminy" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Rezerw+WSPA bpmngen" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_P02_Terminy">
    <bpmn:participant id="Pool_P02_Terminy" name="Uczelnia" processRef="P02_Terminy" />
    <bpmn:participant id="Pool_Mail" name="Serwer poczty uczelni" />
    <bpmn:messageFlow id="Msg_1" name="powiadomienie o zmianie sali" sourceRef="T7" targetRef="Pool_Mail" />
    <bpmn:messageFlow id="Msg_2" name="powiadomienie o odwołaniu" sourceRef="T9" targetRef="Pool_Mail" />
  </bpmn:collaboration>
  <bpmn:process id="P02_Terminy" name="P-02 Zarządzanie terminami konsultacji (TO-BE)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P02_Terminy">
      <bpmn:lane id="Lane_Wyk" name="Wykładowca">
        <bpmn:flowNodeRef>S0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sys" name="System Rezerw+WSPA">
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_sala</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_odw</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S0" name="Wykładowca planuje konsultacje">
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="P-02.1 Zaloguj się">
    </bpmn:userTask>
    <bpmn:manualTask id="T2" name="P-02.2 Sprawdź swój plan zajęć (poza systemem)">
    </bpmn:manualTask>
    <bpmn:userTask id="T3" name="P-02.3 Zdefiniuj godziny, salę i limit miejsc">
    </bpmn:userTask>
    <bpmn:serviceTask id="T4" name="P-02.4 Sprawdź i opublikuj terminy">
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G0" name="Terminy poprawne?">
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T5" name="P-02.5 Przejrzyj kalendarz zapisanych">
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G1" name="Potrzebna zmiana?">
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_ok" name="Terminy aktualne">
    </bpmn:endEvent>
    <bpmn:userTask id="T6" name="P-02.6 Zmień salę konsultacji">
    </bpmn:userTask>
    <bpmn:userTask id="T8" name="P-02.8 Odwołaj termin">
    </bpmn:userTask>
    <bpmn:serviceTask id="T7" name="P-02.7 Zapisz zmianę i powiadom zapisanych">
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T9" name="P-02.9 Anuluj zapisy i powiadom studentów">
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_sala" name="Sala zmieniona">
    </bpmn:endEvent>
    <bpmn:endEvent id="E_odw" name="Termin odwołany">
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="S0" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="T2" targetRef="T3" />
