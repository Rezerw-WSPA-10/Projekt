        <bpmn:flowNodeRef>E_odw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_anul</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S0" name="Student potrzebuje konsultacji">
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="P-01.1 Zaloguj się">
    </bpmn:userTask>
    <bpmn:userTask id="T2" name="P-01.2 Wyszukaj wykładowcę">
    </bpmn:userTask>
    <bpmn:serviceTask id="T3" name="P-01.3 Wyświetl terminy i wolne miejsca">
    </bpmn:serviceTask>
    <bpmn:userTask id="T4" name="P-01.4 Wybierz termin i podaj dane">
    </bpmn:userTask>
    <bpmn:serviceTask id="T5" name="P-01.5 Sprawdź reguły zapisu">
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="Wynik sprawdzenia?">
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T6" name="P-01.6 Zaproponuj najbliższe wolne terminy">
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_odrz" name="Zapis odrzucony">
    </bpmn:endEvent>
    <bpmn:serviceTask id="T7" name="P-01.7 Zapisz rezerwację">
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G2" name="Wybrać proponowany termin?">
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_rez" name="Rezygnacja z zapisu">
    </bpmn:endEvent>
    <bpmn:serviceTask id="T8" name="P-01.8 Wyślij potwierdzenie e-mail">
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="G3" name="Co nastąpi pierwsze?">
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="C_time" name="Nadszedł termin konsultacji">
      <bpmn:timerEventDefinition id="TimerDef_C_time" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="C_odw" name="Wykładowca odwołał termin (P-02)">
      <bpmn:messageEventDefinition id="MsgDef_C_odw" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="T9" name="P-01.9 Zrezygnuj z zapisu">
    </bpmn:userTask>
    <bpmn:serviceTask id="T10" name="P-01.10 Usuń zapis i zwolnij miejsce">
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_odb" name="Konsultacja odbyta">
    </bpmn:endEvent>
    <bpmn:endEvent id="E_odw" name="Konsultacja odwołana">
    </bpmn:endEvent>
    <bpmn:endEvent id="E_anul" name="Zapis anulowany">
    </bpmn:endEvent>
