  <bpmn:collaboration id="Collab_P01_Zapis">
    <bpmn:participant id="Pool_P01_Zapis" name="Uczelnia" processRef="P01_Zapis" />
    <bpmn:participant id="Pool_Mail" name="Serwer poczty uczelni" />
    <bpmn:messageFlow id="Msg_1" name="potwierdzenie zapisu" sourceRef="T5" targetRef="Pool_Mail" />
  </bpmn:collaboration>
  <bpmn:process id="P01_Zapis" name="P-01 Zapis na konsultacje (TO-BE)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P01_Zapis">
      <bpmn:lane id="Lane_St" name="Student">
        <bpmn:flowNodeRef>S0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sys" name="System Rezerw+WSPA">
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S0" name="Student chce się zapisać">
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="P-01.1 Przeglądaj terminy wykładowcy">
    </bpmn:userTask>
    <bpmn:userTask id="T2" name="P-01.2 Wybierz termin i podaj dane">
    </bpmn:userTask>
    <bpmn:serviceTask id="T3" name="P-01.3 Sprawdź reguły zapisu">
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G" name="Reguły spełnione?">
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T6" name="P-01.6 Odrzuć zapis i podaj powód">
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T7" name="P-01.7 Zaproponuj najbliższe terminy">
    </bpmn:serviceTask>
    <bpmn:endEvent id="E2" name="Zapis odrzucony">
    </bpmn:endEvent>
    <bpmn:serviceTask id="T4" name="P-01.4 Zapisz studenta na termin">
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T5" name="P-01.5 Wyślij potwierdzenie">
    </bpmn:serviceTask>
    <bpmn:endEvent id="E1" name="Student zapisany">
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="S0" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="T2" targetRef="T3" />
