  <bpmn:collaboration id="Collab_P01_Zapis">
    <bpmn:participant id="Pool_P01_Zapis" name="Uczelnia" processRef="P01_Zapis" />
    <bpmn:participant id="Pool_Mail" name="Serwer poczty uczelni" />
    <bpmn:messageFlow id="Msg_1" name="potwierdzenie zapisu" sourceRef="T8" targetRef="Pool_Mail" />
  </bpmn:collaboration>
  <bpmn:process id="P01_Zapis" name="P-01 Zapis studenta na konsultacje (TO-BE)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P01_Zapis">
      <bpmn:lane id="Lane_Sys" name="System Rezerw+WSPA">
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_odrz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_time</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_odw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_odb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_odw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_anul</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_St" name="Student">
        <bpmn:flowNodeRef>S0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_rez</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S0" name="Student potrzebuje konsultacji" />
    <bpmn:userTask id="T1" name="P-01.1 Zaloguj się" />
    <bpmn:userTask id="T2" name="P-01.2 Wyszukaj wykładowcę" />
    <bpmn:serviceTask id="T3" name="P-01.3 Wyświetl terminy i wolne miejsca" />
    <bpmn:userTask id="T4" name="P-01.4 Wybierz termin i podaj dane" />
    <bpmn:serviceTask id="T5" name="P-01.5 Sprawdź reguły zapisu" />
    <bpmn:exclusiveGateway id="G1" name="Wynik sprawdzenia?" />
    <bpmn:serviceTask id="T6" name="P-01.6 Zaproponuj najbliższe wolne terminy" />
    <bpmn:endEvent id="E_odrz" name="Zapis odrzucony" />
    <bpmn:serviceTask id="T7" name="P-01.7 Zapisz rezerwację" />
    <bpmn:exclusiveGateway id="G2" name="Wybrać proponowany termin?" />
    <bpmn:endEvent id="E_rez" name="Rezygnacja z zapisu" />
    <bpmn:serviceTask id="T8" name="P-01.8 Wyślij potwierdzenie e-mail" />
    <bpmn:eventBasedGateway id="G3" name="Co nastąpi pierwsze?" />
    <bpmn:intermediateCatchEvent id="C_time" name="Nadszedł termin konsultacji">
      <bpmn:timerEventDefinition id="TimerDef_C_time" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="C_odw" name="Wykładowca odwołał termin (P-02)">
      <bpmn:messageEventDefinition id="MsgDef_C_odw" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="T9" name="P-01.9 Zrezygnuj z zapisu" />
    <bpmn:serviceTask id="T10" name="P-01.10 Usuń zapis i zwolnij miejsce" />
    <bpmn:endEvent id="E_odb" name="Konsultacja odbyta" />
    <bpmn:endEvent id="E_odw" name="Konsultacja odwołana" />
    <bpmn:endEvent id="E_anul" name="Zapis anulowany" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="S0" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="T1" targetRef="T2" />
