  <bpmn:process id="P00_AsIs" name="P-00 Umawianie konsultacji (AS-IS)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P00_AsIs">
      <bpmn:lane id="Lane_St" name="Student">
        <bpmn:flowNodeRef>S0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
