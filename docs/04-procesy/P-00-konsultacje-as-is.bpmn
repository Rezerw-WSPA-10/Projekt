        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Wyk" name="Wykładowca">
        <bpmn:flowNodeRef>TW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S0" name="Student potrzebuje konsultacji">
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="G0" name="Jak się skontaktować?">
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="T1" name="P-00.1 Sprawdź godziny na drzwiach sali">
    </bpmn:manualTask>
    <bpmn:manualTask id="TM" name="P-00.2 Wyślij e-mail z prośbą o termin">
    </bpmn:manualTask>
    <bpmn:manualTask id="TW" name="P-00.3 Odpowiedz na e-mail z terminem">
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="G1" name="Kartka o zmianie sali?">
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="T2" name="P-00.4 Znajdź nową salę">
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="GJ" name="">
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="T3" name="P-00.5 Przyjdź w godzinach konsultacji">
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="G2" name="Wykładowca jest na miejscu?">
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E1" name="Konsultacja nieodbyta (odwołana bez informacji)">
    </bpmn:endEvent>
    <bpmn:manualTask id="T4" name="P-00.6 Czekaj w kolejce pod drzwiami">
    </bpmn:manualTask>
    <bpmn:manualTask id="T5" name="P-00.7 Przyjmuj studentów po kolei">
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="G3" name="Starczyło czasu?">
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="T6" name="P-00.8 Przeprowadź konsultację">
    </bpmn:manualTask>
    <bpmn:endEvent id="E2" name="Konsultacja odbyta">
    </bpmn:endEvent>
    <bpmn:endEvent id="E3" name="Student odchodzi bez konsultacji">
    </bpmn:endEvent>
